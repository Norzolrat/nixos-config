// Configuration niri — traduite depuis la config Hyprland de normi.
// Les commentaires « HYPR: » rappellent l'origine de chaque réglage.

//////////////////////////////////////////////////////////////////////
// Entrées
//////////////////////////////////////////////////////////////////////

input {
    keyboard {
        xkb {
            layout "us"
        }
        // HYPR: repeat_delay 250 / repeat_rate 35
        repeat-delay 250
        repeat-rate 35
        numlock
    }

    touchpad {
        tap
        // HYPR: natural_scroll = yes
        natural-scroll
        // HYPR: disable_while_typing = true
        dwt
        // HYPR: middle_button_emulation = true
        middle-emulation
        // HYPR: scroll_factor = 0.5
        scroll-factor 0.5
        // HYPR: clickfinger_behavior = false → clic par zone, pas par doigts
        click-method "button-areas"
    }

    // HYPR: follow_mouse = 1
    focus-follows-mouse

    // L'écran tactile FTSC1000 DOIT être associé explicitement à la dalle
    // interne. Sans cette ligne, niri l'associe à la première sortie
    // déclarée — potentiellement le HDMI absent — et les touches partent
    // dans le vide.
    touch {
        map-to-output "eDP-1"
    }
}

//////////////////////////////////////////////////////////////////////
// Sorties
//////////////////////////////////////////////////////////////////////

// HYPR: monitor=eDP-1,preferred,auto,1.5
output "eDP-1" {
    mode "2880x1920@120.000"
    scale 1.5
    position x=0 y=0
    // Économie de batterie sur dalle 120Hz : décommente si besoin
    // variable-refresh-rate on-demand=true
}

// HYPR: monitor=HDMI-A-1,1920x1080@60,0x0,1.0
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=1920 y=0
}

// Filet de sécurité si niri se fige encore au démarrage avec l'eGPU branché.
// niri énumère toutes les cartes DRM et en ajoute une comme GPU de rendu ;
// cette ligne le force sur l'iGPU Arc. Normalement inutile : nouveau est
// blacklisté (voir matebook-gt.nix / iso.nix), donc l'eGPU n'expose aucun
// nœud DRM tant qu'on n'a pas démarré sur l'entrée « egpu ».
// Vérifie le bon nœud avant de décommenter : `ls -l /dev/dri/by-path/`.
// debug {
//     render-drm-device "/dev/dri/renderD128"
// }

//////////////////////////////////////////////////////////////////////
// Disposition
//////////////////////////////////////////////////////////////////////

layout {
    // HYPR: gaps_in = 4, gaps_out = 5
    gaps 8

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // HYPR: col.active_border = rgba(0DB7D4FF), border_size = 1
    focus-ring {
        width 2
        active-color "#0DB7D4"
        inactive-color "#31313600"
    }

    border {
        off
    }

    // HYPR: shadow { range 30, offset 0 2, color rgba(00000010) }
    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=2
        color "#00000030"
    }

    // Réserve la place de la barre Noctalia (bar.position = top).
    // À ajuster si la barre déborde ou laisse un vide.
    struts {
        top 0
        bottom 0
    }
}

//////////////////////////////////////////////////////////////////////
// Démarrage
//////////////////////////////////////////////////////////////////////

// HYPR: exec-once = qs -c noctalia-shell
spawn-at-startup "noctalia-shell"

// HYPR: special workspace (Super+S). niri n'a PAS de scratchpad qui se
// superpose au workspace courant. L'approximation la plus proche est un
// workspace nommé, atteignable d'une touche depuis n'importe où.
// Différence à accepter : il REMPLACE la vue au lieu de la recouvrir.
workspace "scratch"

// HYPR: exec-once = fcitx5
spawn-at-startup "fcitx5"

// HYPR: exec-once = easyeffects --gapplication-service
spawn-at-startup "easyeffects" "--gapplication-service"

// Les surveillants de presse-papiers ne sont PAS relancés ici : ton
// settings.json Noctalia les démarre déjà via clipboardWatchTextCommand
// et clipboardWatchImageCommand. Les dupliquer créerait des doublons
// dans l'historique.

// HYPR: exec-once = hypridle → remplacé par swayidle (voir desktop.nix)

// HYPR: exec-once = lockScreen toggle au démarrage
// spawn-at-startup "noctalia-shell" "ipc" "call" "lockScreen" "lock"

//////////////////////////////////////////////////////////////////////
// Divers
//////////////////////////////////////////////////////////////////////

prefer-no-csd

// HYPR: le script de capture écrivait dans Pictures/Screenshots
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H.%M.%S.png"

// HYPR: cursor Bibata-Modern-Classic 24
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

// HYPR: animations rapides (emphasizedDecel, durées 1-3)
animations {
    slowdown 0.7
}

// HYPR: gesture = 4, horizontal, workspace
// niri gère nativement le balayage 3 doigts pour les colonnes et
// les workspaces, sans configuration.
gestures {
    hot-corners {
        off
    }
}

// HYPR: env.conf
environment {
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    _JAVA_AWT_WM_NONREPARENTING "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    NIXOS_OZONE_WL "1"
    // Méthode de saisie fcitx5
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
    INPUT_METHOD "fcitx"
    // HYPR: QT_QPA_PLATFORMTHEME = kde → sans Plasma, on passe par qt6ct
    QT_QPA_PLATFORMTHEME "qt6ct"
    DISPLAY ":0"
}

//////////////////////////////////////////////////////////////////////
// Règles de fenêtres
//////////////////////////////////////////////////////////////////////

// HYPR: rounding = 18 + opacity 0.9 global
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    opacity 0.9
}

// Les fenêtres de jeu restent opaques (l'opacité globale gêne en jeu)
window-rule {
    match app-id=r#"^steam_app"#
    opacity 1.0
}

// HYPR: windowrule float on pour les utilitaires
window-rule {
    match app-id=r#"^(pavucontrol|org\.pulseaudio\.pavucontrol)$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"^blueberry\.py$"#
    match app-id=r#"^Zotero$"#
    open-floating true
    default-column-width { proportion 0.45; }
}

// HYPR: Picture-in-Picture flottant, épinglé, en bas à droite
window-rule {
    match title=r#"[Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// HYPR: dialogues Open File / Save As / File Upload flottants et centrés
window-rule {
    match title=r#"^(Open File|Select a File|Open Folder|Save As|File Upload|Choose wallpaper|Library)"#
    match title=r#"wants to (save|open)$"#
    open-floating true
}

//////////////////////////////////////////////////////////////////////
// Raccourcis
//////////////////////////////////////////////////////////////////////

binds {
    //------------------------------------------------------------------
    // Shell Noctalia — identiques à Hyprland, seul « qs -c » disparaît
    //------------------------------------------------------------------
    Mod+D           { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+A           { spawn "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+I           { spawn "noctalia-shell" "ipc" "call" "settings" "toggle"; }
    Mod+L           { spawn "noctalia-shell" "ipc" "call" "lockScreen" "toggle"; }
    Mod+V           { spawn "noctalia-shell" "ipc" "call" "plugin:clipper" "openPanel"; }
    Mod+Period      { spawn "noctalia-shell" "ipc" "call" "launcher" "calculator"; }
    Mod+Slash       { spawn "noctalia-shell" "ipc" "call" "notifications" "toggleHistory"; }
    Mod+Alt+Slash   { spawn "noctalia-shell" "ipc" "call" "notifications" "toggleDND"; }
    Mod+Alt+D       { spawn "noctalia-shell" "ipc" "call" "darkMode" "toggle"; }
    Ctrl+Mod+T      { spawn "noctalia-shell" "ipc" "call" "wallpaper" "random"; }
    Mod+Shift+E     { spawn "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    Ctrl+Alt+Delete { spawn "noctalia-shell" "ipc" "call" "powerPanel" "toggle"; }

    // Aide-mémoire des raccourcis, natif dans niri. C'est le bind par
    // défaut du compositeur, celui qui te manquait.
    Mod+Shift+Slash { show-hotkey-overlay; }

    //------------------------------------------------------------------
    // Luminosité / volume — allow-when-locked pour agir écran verrouillé
    //------------------------------------------------------------------
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "brightness" "decrease"; }
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "noctalia-shell" "ipc" "call" "volume" "muteInput"; }

    //------------------------------------------------------------------
    // Captures — natives dans niri, grim/slurp ne sont plus nécessaires
    //------------------------------------------------------------------
    Mod+Shift+S { screenshot; }               // HYPR: région → presse-papiers
    Print       { screenshot-screen; }        // HYPR: plein écran → presse-papiers
    Ctrl+Print  { screenshot-window; }

    // OCR et pipette : pas d'équivalent natif, on garde tes outils
    Mod+Shift+T { spawn "sh" "-c" "grim -g \"$(slurp)\" /tmp/ocr.png && tesseract /tmp/ocr.png - | wl-copy && rm /tmp/ocr.png"; }
    Mod+Shift+C { spawn "hyprpicker" "-a"; }

    // Enregistrement — le script utilise wf-recorder, qui fonctionne sur
    // niri. Il faudra remplacer l'appel `hyprctl monitors` qu'il contient.
    Mod+Alt+R       { spawn "sh" "-c" "~/.config/niri/scripts/record.sh"; }
    Mod+Shift+Alt+R { spawn "sh" "-c" "~/.config/niri/scripts/record.sh --fullscreen-sound"; }

    //------------------------------------------------------------------
    // Fenêtres
    //------------------------------------------------------------------
    Mod+Q     { close-window; }               // HYPR: Super+Q killactive
    Alt+F4    { close-window; }

    Mod+Alt+Space { toggle-window-floating; } // HYPR: togglefloating
    Mod+F         { maximize-column; }        // HYPR: fullscreen,1
    Mod+Alt+F     { fullscreen-window; }      // HYPR: fullscreen,0

    // HYPR: Super+P (pin) — pas d'équivalent niri. Le plus proche est de
    // rendre la fenêtre flottante, qui reste alors au-dessus des tuiles.

    //------------------------------------------------------------------
    // Focus et déplacement
    //------------------------------------------------------------------
    // Dans Hyprland, Super+Left/Right changeait de workspace (ton bind
    // « workspace e-1 » écrasait « movefocus »). Dans niri, le même geste
    // fait défiler les colonnes : c'est l'équivalent naturel.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // HYPR: splitratio -0.1 / +0.1
    Mod+Semicolon  { set-column-width "-10%"; }
    Mod+Apostrophe { set-column-width "+10%"; }
    Mod+R          { switch-preset-column-width; }
    Mod+Shift+R    { reset-window-height; }
    Mod+Comma      { consume-or-expel-window-left; }
    Mod+Backslash  { consume-or-expel-window-right; }

    //------------------------------------------------------------------
    // Workspaces — verticaux dans niri, horizontaux dans Hyprland
    //------------------------------------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    // Déplacer la fenêtre courante d'un workspace à l'autre, en relatif.
    // Les workspaces niri étant empilés verticalement, haut/bas est le
    // geste naturel — l'équivalent du movetoworkspace relatif d'Hyprland.
    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }

    // Variante ne déplaçant que la fenêtre focalisée, si la colonne en
    // contient plusieurs :
    // Mod+Ctrl+Shift+Up   { move-window-to-workspace-up; }
    // Mod+Ctrl+Shift+Down { move-window-to-workspace-down; }

    // HYPR: Super+S / Super+Alt+S — le « bureau par-dessus tout »
    Mod+S     { focus-workspace "scratch"; }
    Mod+Alt+S { move-column-to-workspace "scratch"; }

    // HYPR: hyprexpo (Super+S scratchpad n'a pas d'équivalent, mais
    // l'overview intégré remplace avantageusement le plugin)
    Mod+Tab { toggle-overview; }
    Alt+Tab { focus-window-previous; }

    //------------------------------------------------------------------
    // Applications — tes scripts launch_first_available deviennent inutiles,
    // les paquets sont garantis présents par Nix.
    //------------------------------------------------------------------
    Mod+Return  { spawn "alacritty"; }
    Mod+W       { spawn "zen-beta"; }                    // à ajuster selon mainProgram
    Mod+C       { spawn "code"; }
    Mod+E       { spawn "nautilus"; }
    Mod+Shift+W { spawn "onlyoffice-desktopeditors"; }
    Ctrl+Mod+V  { spawn "pavucontrol"; }
    Ctrl+Shift+Escape { spawn "alacritty" "-e" "btop"; }

    //------------------------------------------------------------------
    // Session
    //------------------------------------------------------------------
    Mod+Shift+L { spawn "systemctl" "suspend"; }
    Ctrl+Shift+Alt+Mod+Delete { spawn "systemctl" "poweroff"; }
    Mod+Shift+Q { quit; }

    // HYPR: Ctrl+Super+R redémarrait le shell
    Ctrl+Mod+R { spawn "sh" "-c" "pkill noctalia-shell; sleep 0.2; noctalia-shell & disown"; }

    // Molette : défilement entre colonnes
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
}
