// Configuration niri.
//
// Les raccourcis portent un attribut hotkey-overlay-title : c'est lui qui
// sert de description, à la fois dans l'aide-mémoire natif de niri et dans
// le plugin Noctalia « keybind-cheatsheet ». Dans le bloc binds, une ligne
// de la forme //"Nom" ouvre une catégorie pour le plugin — d'où les
// en-têtes entre guillemets. Un commentaire ordinaire ne doit donc jamais
// commencer par un guillemet, sous peine de créer une catégorie fantôme.

//////////////////////////////////////////////////////////////////////
// Entrées
//////////////////////////////////////////////////////////////////////

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 35
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
        middle-emulation
        scroll-factor 0.5
        // Deux chemins indépendants vers le clic droit :
        // - tap-button-map : un TAP à 2 doigts (effleurement bref, pas de
        //   pression physique) = clic droit. Indépendant de click-method,
        //   déjà validé, fonctionne bien.
        // - click-method button-areas : une PRESSION physique dans le coin
        //   bas-droit = clic droit (clickfinger ne permet pas ça, il ne
        //   distingue que le nombre de doigts, pas la position).
        tap-button-map "left-right-middle"
        click-method "button-areas"
    }

    focus-follows-mouse

    // L'écran tactile FTSC1000 DOIT être associé explicitement à la dalle
    // interne. Sans cette ligne, niri l'associe à la première sortie
    // déclarée — potentiellement le HDMI absent — et les touches partent
    // dans le vide.
    touch {
        map-to-output "eDP-1"
    }
}

//////////////////////////////////////////////////////////////////////
// Sorties
//////////////////////////////////////////////////////////////////////

output "eDP-1" {
    mode "2880x1920@120.000"
    scale 1.5
    position x=0 y=0
    // Économie de batterie sur dalle 120Hz : décommente si besoin
    // variable-refresh-rate on-demand=true
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=1920 y=0
}

// Filet de sécurité si niri se fige encore au démarrage avec l'eGPU branché.
// niri énumère toutes les cartes DRM et en ajoute une comme GPU de rendu ;
// cette ligne le force sur l'iGPU Arc. Normalement inutile : nouveau est
// blacklisté (voir matebook-gt.nix / iso.nix), donc l'eGPU n'expose aucun
// nœud DRM tant qu'on n'a pas démarré sur l'entrée « egpu ».
// Vérifie le bon nœud avant de décommenter : `ls -l /dev/dri/by-path/`.
debug {
//     render-drm-device "/dev/dri/renderD128"
    render-drm-device "/dev/dri/by-path/pci-0000:00:02.0-render"
}

//////////////////////////////////////////////////////////////////////
// Disposition
//////////////////////////////////////////////////////////////////////

layout {
    gaps 8

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#0DB7D4"
        inactive-color "#31313600"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=2
        color "#00000030"
    }

    // Réserve la place de la barre Noctalia (bar.position = top).
    // À ajuster si la barre déborde ou laisse un vide.
    struts {
        top 0
        bottom 0
    }
}

//////////////////////////////////////////////////////////////////////
// Démarrage
//////////////////////////////////////////////////////////////////////

// Le shell (barre, panneaux, verrouillage, fond d'écran) n'est PAS lancé
// ici : programs.noctalia.systemd.enable dans desktop.nix en fait un service
// utilisateur, démarré avec graphical-session.target. Le lancer aussi depuis
// niri donnerait deux instances.

// niri n'a pas de scratchpad qui se superpose au workspace courant.
// L'approximation la plus proche est un workspace nommé, atteignable d'une
// touche depuis n'importe où (Mod+S).
// Différence à accepter : il REMPLACE la vue au lieu de la recouvrir.
workspace "scratch"

// Méthode de saisie (voir i18n.inputMethod dans desktop.nix).
spawn-at-startup "fcitx5"

// Traitement audio en service, sans fenêtre.
spawn-at-startup "easyeffects" "--gapplication-service"

// Spotify démarre avec la session. Il n'a pas de mode « service » : sa
// fenêtre existe forcément, elle est donc envoyée sur le workspace
// « scratch » et n'attrape pas le focus (voir la règle de fenêtre plus bas).
// Mod+S pour l'y rejoindre.
spawn-at-startup "spotify"

// Aucun surveillant de presse-papiers ici : la v5 gère l'historique
// elle-même (clipboard_enabled dans config.toml). En lancer un en parallèle
// créerait des doublons.

// La gestion de l'inactivité passe par swayidle (voir desktop.nix).

// Verrouiller dès l'ouverture de session, si tu le souhaites un jour :
// spawn-at-startup "noctalia" "msg" "lock"

//////////////////////////////////////////////////////////////////////
// Divers
//////////////////////////////////////////////////////////////////////

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H.%M.%S.png"

// L'aide-mémoire natif ne s'affiche plus à l'ouverture de session : il est
// remplacé par le plugin Noctalia, appelé à la demande par Mod+Shift+Slash.
hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

animations {
    slowdown 0.7
}

// niri gère nativement le balayage 3 doigts pour les colonnes et les
// workspaces, sans configuration. Seuls les coins actifs sont désactivés.
gestures {
    hot-corners {
        off
    }
}

environment {
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    _JAVA_AWT_WM_NONREPARENTING "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    NIXOS_OZONE_WL "1"
    // Méthode de saisie fcitx5.
    // QT_IM_MODULE et INPUT_METHOD sont volontairement absents : en mode
    // waylandFrontend (cf. i18n.inputMethod dans desktop.nix) les applis
    // Wayland natives, Qt6 compris, passent par text-input-v3. Les reposer
    // ici annulerait le correctif et ferait réapparaître l'avertissement.
    // Ce qui suit ne concerne que les applis XWayland, qui n'ont pas accès
    // au protocole Wayland et ont donc encore besoin du pont X11.
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    // GLFW ne parle que le protocole ibus, que fcitx5 sait émuler.
    GLFW_IM_MODULE "ibus"
    // Sans Plasma, le thème des applis Qt est piloté par qt6ct.
    QT_QPA_PLATFORMTHEME "qt6ct"
    DISPLAY ":0"
}

//////////////////////////////////////////////////////////////////////
// Règles de fenêtres
//////////////////////////////////////////////////////////////////////

// Arrondi et transparence appliqués à toutes les fenêtres.
//
// draw-border-with-background false est indispensable ici : avec
// prefer-no-csd, les fenêtres qui acceptent les décorations serveur voient
// leur focus-ring peint comme un rectangle PLEIN derrière elles. Combiné à
// opacity 0.9, l'active-color transparaissait au travers et la fenêtre
// semblait perdre sa transparence dès qu'elle prenait le focus. À false, le
// focus-ring redevient un simple contour.
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    opacity 0.9
    draw-border-with-background false
}

// Les fenêtres de jeu restent opaques (l'opacité globale gêne en jeu).
window-rule {
    match app-id=r#"^steam_app"#
    opacity 1.0
}

// Spotify, lancé au démarrage : il ne doit ni voler le focus au moment où tu
// ouvres ta session, ni s'installer sur le workspace courant.
// Si le workspace « scratch » n'existe pas, niri ouvre la fenêtre sur le
// workspace courant — mais il est déclaré plus haut, donc ça n'arrivera pas.
window-rule {
    match app-id=r#"^spotify$"#
    open-on-workspace "scratch"
    open-focused false
}

// Utilitaires de configuration : ouverts flottants, à 45 % de large.
window-rule {
    match app-id=r#"^(pavucontrol|org\.pulseaudio\.pavucontrol)$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"^blueberry\.py$"#
    match app-id=r#"^Zotero$"#
    open-floating true
    default-column-width { proportion 0.45; }
}

// Picture-in-Picture : flottant, ancré en bas à droite.
window-rule {
    match title=r#"[Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// Dialogues de fichiers : flottants plutôt que tuilés.
window-rule {
    match title=r#"^(Open File|Select a File|Open Folder|Save As|File Upload|Choose wallpaper|Library)"#
    match title=r#"wants to (save|open)$"#
    open-floating true
}

//////////////////////////////////////////////////////////////////////
// Raccourcis
//////////////////////////////////////////////////////////////////////

binds {
    //"Shell Noctalia"
    Mod+D           hotkey-overlay-title="Lanceur d'applications" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+A           hotkey-overlay-title="Centre de contrôle" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+I           hotkey-overlay-title="Réglages de Noctalia" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+L           hotkey-overlay-title="Verrouiller l'écran" { spawn "noctalia" "msg" "lock"; }
    // Le presse-papiers a son propre panneau en v5, il ne passe plus par un
    // onglet du lanceur. Les identifiants de panneaux valides sont launcher,
    // control-center, notifications, clipboard et session ; la liste complète
    // des commandes est donnée par `noctalia msg --help`.
    Mod+V           hotkey-overlay-title="Historique du presse-papiers" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Shift+V     hotkey-overlay-title="Historique du presse-papiers" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    // Le calcul et les emoji se tapent dans le lanceur, avec les préfixes de
    // fournisseurs de la v5 (« /emo » par exemple).
    Mod+Period      hotkey-overlay-title="Lanceur — calcul et emoji" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Slash       hotkey-overlay-title="Historique des notifications" { spawn "noctalia" "msg" "panel-toggle" "notifications"; }
    Mod+Alt+Slash   hotkey-overlay-title="Mode Ne pas déranger" { spawn "noctalia" "msg" "notification-dnd-toggle"; }
    // theme-mode-toggle ne bascule PAS entre deux états : il cycle sur trois,
    // sombre → clair → auto → sombre. Le mode « auto » suit le lever et le
    // coucher du soleil calculés depuis ta position, et fait donc changer le
    // thème tout seul — y compris la nuit. C'est ce qui est arrivé le
    // 2026-08-16. On force donc directement le mode sombre.
    Mod+Alt+D       hotkey-overlay-title="Forcer le thème sombre" { spawn "noctalia" "msg" "theme-mode-set" "dark"; }
    Ctrl+Mod+T      hotkey-overlay-title="Fond d'écran aléatoire" { spawn "noctalia" "msg" "wallpaper-random"; }
    // Le menu de session est un panneau comme les autres en v5.
    Mod+Shift+E     hotkey-overlay-title="Menu de session" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Menu de session" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // Aide-mémoire des raccourcis, fourni par le plugin kenn/keybind-cheatsheet.
    // En v5 un plugin expose un panneau comme n'importe quel autre, adressé
    // par <auteur>/<plugin>:<entrée> — l'identifiant se relève avec
    // `noctalia msg plugins list`.
    // Le plugin lit CE fichier et affiche les hotkey-overlay-title, catégorie
    // par catégorie : c'est ce qui rend les descriptions ci-dessus utiles.
    Mod+Shift+Slash hotkey-overlay-title="Aide-mémoire des raccourcis" { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    //"Luminosité et volume"
    // allow-when-locked : ces touches restent actives écran verrouillé.
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Augmenter la luminosité" { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Diminuer la luminosité" { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioRaiseVolume  allow-when-locked=true hotkey-overlay-title="Augmenter le volume" { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true hotkey-overlay-title="Diminuer le volume" { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true hotkey-overlay-title="Couper le son" { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true hotkey-overlay-title="Couper le micro" { spawn "noctalia" "msg" "mic-mute"; }

    //"Captures et enregistrement"
    Mod+Shift+S hotkey-overlay-title="Capturer une région" { screenshot; }
    Print       hotkey-overlay-title="Capturer l'écran entier" { screenshot-screen; }
    Ctrl+Print  hotkey-overlay-title="Capturer la fenêtre active" { screenshot-window; }

    // OCR et pipette : pas d'équivalent natif dans niri, on garde les outils.
    Mod+Shift+T hotkey-overlay-title="Texte d'une région vers le presse-papiers (OCR)" { spawn "sh" "-c" "grim -g \"$(slurp)\" /tmp/ocr.png && tesseract /tmp/ocr.png - | wl-copy && rm /tmp/ocr.png"; }
    Mod+Shift+C hotkey-overlay-title="Pipette de couleur" { spawn "hyprpicker" "-a"; }

    // Le script s'appuie sur wf-recorder, compatible niri. L'appel
    // `hyprctl monitors` qu'il contient reste à remplacer.
    Mod+Alt+R       hotkey-overlay-title="Enregistrer l'écran" { spawn "sh" "-c" "~/.config/niri/scripts/record.sh"; }
    Mod+Shift+Alt+R hotkey-overlay-title="Enregistrer l'écran avec le son" { spawn "sh" "-c" "~/.config/niri/scripts/record.sh --fullscreen-sound"; }

    //"Fenêtres"
    Mod+Q     hotkey-overlay-title="Fermer la fenêtre" { close-window; }
    Alt+F4    hotkey-overlay-title="Fermer la fenêtre" { close-window; }

    Mod+Alt+Space hotkey-overlay-title="Basculer entre flottant et tuilé" { toggle-window-floating; }
    Mod+Alt+F     hotkey-overlay-title="Plein écran" { fullscreen-window; }

    // Agrandir une fenêtre, c'est se concentrer dessus : elle passe donc
    // opaque en même temps. niri n'a pas de match is-maximized ni
    // is-fullscreen en window-rule, la règle d'opacité ne peut pas suivre
    // toute seule — on enchaîne les deux actions à la main.
    //
    // À savoir : toggle-window-rule-opacity pose un verrou PERSISTANT sur la
    // fenêtre. Il ne se réarme ni en quittant le maximise, ni en quittant le
    // plein écran, seulement à la fermeture de la fenêtre. Les deux bascules
    // ne restent donc synchronisées que si tu ressors par le raccourci qui
    // t'a fait entrer. Si une fenêtre reste opaque sans raison, réappuyer
    // sur ce raccourci la remet d'aplomb.
    Mod+F         hotkey-overlay-title="Maximiser la colonne, en opaque" { spawn "sh" "-c" "niri msg action maximize-column && niri msg action toggle-window-rule-opacity"; }
    Mod+Shift+F   hotkey-overlay-title="Plein écran, en opaque" { spawn "sh" "-c" "niri msg action fullscreen-window && niri msg action toggle-window-rule-opacity"; }

    // Épingler une fenêtre n'existe pas dans niri. Le plus proche est de la
    // rendre flottante (Mod+Alt+Space) : elle reste alors au-dessus des tuiles.

    //"Focus et déplacement"
    Mod+Left  hotkey-overlay-title="Colonne précédente" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Colonne suivante" { focus-column-right; }
    Mod+Up    hotkey-overlay-title="Fenêtre du dessus" { focus-window-up; }
    Mod+Down  hotkey-overlay-title="Fenêtre du dessous" { focus-window-down; }

    Mod+Shift+Left  hotkey-overlay-title="Déplacer la colonne à gauche" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="Déplacer la colonne à droite" { move-column-right; }
    Mod+Shift+Up    hotkey-overlay-title="Déplacer la fenêtre vers le haut" { move-window-up; }
    Mod+Shift+Down  hotkey-overlay-title="Déplacer la fenêtre vers le bas" { move-window-down; }

    Mod+Home hotkey-overlay-title="Première colonne" { focus-column-first; }
    Mod+End  hotkey-overlay-title="Dernière colonne" { focus-column-last; }

    // *-next plutôt que *-right : avec plus de deux écrans, -right ne fait
    // rien s'il n'y a pas de moniteur physiquement à droite, alors que -next
    // cycle dans l'ordre des écrans (et boucle sur le premier à la fin).
    Mod+P       hotkey-overlay-title="Écran suivant" { focus-monitor-next; }
    Mod+Shift+P hotkey-overlay-title="Envoyer la fenêtre sur l'écran suivant" { move-window-to-monitor-next; }

    Mod+Semicolon  hotkey-overlay-title="Rétrécir la colonne de 10 %" { set-column-width "-10%"; }
    Mod+Apostrophe hotkey-overlay-title="Élargir la colonne de 10 %" { set-column-width "+10%"; }
    Mod+R          hotkey-overlay-title="Largeur de colonne suivante" { switch-preset-column-width; }
    Mod+Shift+R    hotkey-overlay-title="Réinitialiser la hauteur" { reset-window-height; }
    Mod+Comma      hotkey-overlay-title="Absorber ou expulser la fenêtre à gauche" { consume-or-expel-window-left; }
    Mod+Backslash  hotkey-overlay-title="Absorber ou expulser la fenêtre à droite" { consume-or-expel-window-right; }

    //"Bureaux"
    // Les bureaux sont empilés verticalement dans niri.
    Mod+1 hotkey-overlay-title="Aller au bureau 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Aller au bureau 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Aller au bureau 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Aller au bureau 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Aller au bureau 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Aller au bureau 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Aller au bureau 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Aller au bureau 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Aller au bureau 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="Aller au bureau 10" { focus-workspace 10; }

    Mod+Shift+1 hotkey-overlay-title="Envoyer la colonne au bureau 1" { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="Envoyer la colonne au bureau 2" { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="Envoyer la colonne au bureau 3" { move-column-to-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title="Envoyer la colonne au bureau 4" { move-column-to-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title="Envoyer la colonne au bureau 5" { move-column-to-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title="Envoyer la colonne au bureau 6" { move-column-to-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title="Envoyer la colonne au bureau 7" { move-column-to-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title="Envoyer la colonne au bureau 8" { move-column-to-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title="Envoyer la colonne au bureau 9" { move-column-to-workspace 9; }
    Mod+Shift+0 hotkey-overlay-title="Envoyer la colonne au bureau 10" { move-column-to-workspace 10; }

    Mod+Page_Down hotkey-overlay-title="Bureau suivant" { focus-workspace-down; }
    Mod+Page_Up   hotkey-overlay-title="Bureau précédent" { focus-workspace-up; }

    Mod+Ctrl+Up   hotkey-overlay-title="Envoyer la colonne au bureau du dessus" { move-column-to-workspace-up; }
    Mod+Ctrl+Down hotkey-overlay-title="Envoyer la colonne au bureau du dessous" { move-column-to-workspace-down; }

    // Variante ne déplaçant que la fenêtre focalisée, si la colonne en
    // contient plusieurs :
    // Mod+Ctrl+Shift+Up   { move-window-to-workspace-up; }
    // Mod+Ctrl+Shift+Down { move-window-to-workspace-down; }

    // Escamote Spotify : piri sort la fenêtre de l'écran et la ramène, sans
    // changer de workspace. Si Spotify n'est pas lancé, piri le démarre.
    Mod+M     hotkey-overlay-title="Afficher ou masquer Spotify" { spawn "piri" "scratchpads" "spotify" "toggle"; }

    Mod+S     hotkey-overlay-title="Aller au bureau scratch" { focus-workspace "scratch"; }
    Mod+Alt+S hotkey-overlay-title="Envoyer la colonne au bureau scratch" { move-column-to-workspace "scratch"; }

    Mod+Tab hotkey-overlay-title="Vue d'ensemble" { toggle-overview; }
    Alt+Tab hotkey-overlay-title="Fenêtre précédente" { focus-window-previous; }

    //"Applications"
    Mod+Return  hotkey-overlay-title="Terminal (Alacritty)" { spawn "alacritty"; }
    Mod+W       hotkey-overlay-title="Navigateur (Zen)" { spawn "zen-beta"; }
    Mod+C       hotkey-overlay-title="Éditeur de code (VS Code)" { spawn "code"; }
    Mod+E       hotkey-overlay-title="Explorateur de fichiers (Nautilus)" { spawn "nautilus"; }
    Mod+Shift+W hotkey-overlay-title="Suite bureautique (OnlyOffice)" { spawn "onlyoffice-desktopeditors"; }
    Ctrl+Mod+V  hotkey-overlay-title="Mixeur audio (pavucontrol)" { spawn "pavucontrol"; }
    Ctrl+Shift+Escape hotkey-overlay-title="Moniteur système (btop)" { spawn "alacritty" "-e" "btop"; }

    //"Session"
    Mod+Shift+L hotkey-overlay-title="Mettre en veille" { spawn "systemctl" "suspend"; }
    Ctrl+Shift+Alt+Mod+Delete hotkey-overlay-title="Éteindre l'ordinateur" { spawn "systemctl" "poweroff"; }
    Mod+Shift+Q hotkey-overlay-title="Quitter niri" { quit; }

    // Le shell est un service utilisateur : systemctl le redémarre proprement,
    // là où le pkill de la v4 laissait l'ancien processus mourir à l'aveugle.
    Ctrl+Mod+R hotkey-overlay-title="Redémarrer le shell Noctalia" { spawn "systemctl" "--user" "restart" "noctalia"; }

    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Colonne suivante (molette)" { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Colonne précédente (molette)" { focus-column-left; }
}
